PORT=4000
# ОБЯЗАТЕЛЬНО в продакшене (NODE_ENV=production): длинная случайная строка.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Первый супер-администратор (npm run seed)
SEED_ADMIN_TABEL=1
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NAME=Главный администратор
# Максимальный табельный номер (по умолчанию 3000)
# TABEL_MAX=3000
# Если сервер стоит за nginx/Caddy — число прокси перед ним (нужно для ограничения попыток входа по IP)
# TRUST_PROXY=1
# Разрешить запросы с других адресов (через запятую). По умолчанию выключено: клиент ходит через прокси.
# CORS_ORIGIN=https://kaizen.example.com
